38919>>>        tWebNavigateData NavigateData
38919>>>        tWebNavigateData NavigateData
38919>>>        Boolean bHasRecord
38919>>>        Handle hoDD
38919>>>
38919>>>        Get Server to hoDD
38920>>>        Get GetNavigateData to NavigateData
38921>>>        Get HasRecord of hoDD to bHasRecord
38922>>>
38922>>>        // let's hide all buttons and then Show the ones we want
38922>>>        WebSet pbRender of oEditBtn to False
38923>>>        WebSet pbRender of oSaveBtn to False
38924>>>        WebSet pbRender of oCancelChangesBtn to False
38925>>>        WebSet pbRender of oDeleteBtn to False
38926>>>
38926>>>        If (NavigateData.bReadOnly) Begin
38928>>>            WebSet pbRender of oEditBtn to True
38929>>>        End
38929>>>>
38929>>>        Else Begin
38930>>>            WebSet pbRender of oSaveBtn to True
38931>>>            WebSet pbRender of oCancelChangesBtn to True
38932>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38933>>>        End
38933>>>>
