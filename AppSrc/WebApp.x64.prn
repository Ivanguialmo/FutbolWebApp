38312>>>    Procedure SetActionButtons
38315>>>        tWebNavigateData NavigateData
38315>>>        tWebNavigateData NavigateData
38315>>>        Boolean bHasRecord
38315>>>        Handle hoDD
38315>>>
38315>>>        Get Server to hoDD
38316>>>        Get GetNavigateData to NavigateData
38317>>>        Get HasRecord of hoDD to bHasRecord
38318>>>
38318>>>        // let's hide all buttons and then Show the ones we want
38318>>>        WebSet pbRender of oEditBtn to False
38319>>>        WebSet pbRender of oSaveBtn to False
38320>>>        WebSet pbRender of oCancelChangesBtn to False
38321>>>        WebSet pbRender of oDeleteBtn to False
38322>>>
38322>>>        If (NavigateData.bReadOnly) Begin
38324>>>            WebSet pbRender of oEditBtn to True
38325>>>        End
38325>>>>
38325>>>        Else Begin
38326>>>            WebSet pbRender of oSaveBtn to True
38327>>>            WebSet pbRender of oCancelChangesBtn to True
38328>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38329>>>        End
38329>>>>
38329>>>    End_Procedure
38330>>>
