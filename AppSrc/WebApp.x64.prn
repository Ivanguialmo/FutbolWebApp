39064>>>        If (HasRecord(Server(Self)))Begin
39066>>>            Send SetHeaderCaption (jugador.Nombre)
39067>>>            Send SetBreadcrumbCaption (jugador.Nombre*jugador.Apellido)
39068>>>        End
39068>>>>
39068>>>        Else Begin
