38443>>>            Case (NavigateData.eNavigateType = nfFromParent)
38445>>>                // If from parent, this is a constrained drill down
38445>>>                // If Row select does main-zoom we don't need this
38445>>>                WebSet pbRender of oDetailButton to False
38446>>>                Case Break
38447>>>
38447>>>            Case (NavigateData.eNavigateType = nfFromChild)
38450>>>                // If from child, this is a probably a parent lookup from a Zoom
38450>>>                Case Break
38451>>>
38451>>>            Case (NavigateData.eNavigateType = nfFromMain)
38454>>>                // If from main, this is a probably a main-file lookup from a Zoom
38454>>>                WebSet pbRender of oDetailButton to False
38455>>>                Case Break
38456>>>
38456>>>            Case Else // must be nfUndefined
38456>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38456>>>                // If Row select does main-zoom we don't need this
38456>>>                Send ShowInfoBox "Esto es una navegación indefinida"
38457>>>                WebSet pbRender of oDetailButton to False
38458>>>
38458>>>        Case End
38458>>>
38458>>>    End_Procedure
