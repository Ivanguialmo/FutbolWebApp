37627>>>    Procedure SetActionButtons
37630>>>        tWebNavigateData NavigateData
37630>>>        tWebNavigateData NavigateData
37630>>>        Boolean bHasRecord
37630>>>        Handle hoDD
37630>>>
37630>>>        Get Server to hoDD
37631>>>        Get GetNavigateData to NavigateData
37632>>>        Get HasRecord of hoDD to bHasRecord
37633>>>
37633>>>        // let's hide all buttons and then Show the ones we want
37633>>>        WebSet pbRender of oEditBtn to False
37634>>>        WebSet pbRender of oSaveBtn to False
37635>>>        WebSet pbRender of oCancelChangesBtn to False
37636>>>        WebSet pbRender of oDeleteBtn to False
37637>>>
37637>>>        If (NavigateData.bReadOnly) Begin
37639>>>            WebSet pbRender of oEditBtn to True
37640>>>        End
37640>>>>
37640>>>        Else Begin
37641>>>            WebSet pbRender of oSaveBtn to True
