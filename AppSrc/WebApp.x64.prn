38977>>>    Procedure SetActionButtons
38980>>>        tWebNavigateData NavigateData
38980>>>        tWebNavigateData NavigateData
38980>>>        Boolean bHasRecord
38980>>>        Handle hoDD
38980>>>
38980>>>        Get Server to hoDD
38981>>>        Get GetNavigateData to NavigateData
38982>>>        Get HasRecord of hoDD to bHasRecord
38983>>>
38983>>>        // let's hide all buttons and then Show the ones we want
38983>>>        WebSet pbRender of oEditBtn to False
38984>>>        WebSet pbRender of oSaveBtn to False
38985>>>        WebSet pbRender of oCancelChangesBtn to False
38986>>>        WebSet pbRender of oDeleteBtn to False
38987>>>
38987>>>        If (NavigateData.bReadOnly) Begin
38989>>>            WebSet pbRender of oEditBtn to True
38990>>>        End
38990>>>>
38990>>>        Else Begin
38991>>>            WebSet pbRender of oSaveBtn to True
38992>>>            WebSet pbRender of oCancelChangesBtn to True
38993>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38994>>>        End
38994>>>>
38994>>>    End_Procedure
38995>>>
