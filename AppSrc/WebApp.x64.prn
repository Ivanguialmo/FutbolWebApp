37582>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37585>>>        Case Begin
37585>>>            Case (NavigateData.eNavigateType = nfFromMain)
37587>>>                // If from main, this is a propbably a main file Select to Zoom.
37587>>>                Case Break
37588>>>
37588>>>            Case (NavigateData.eNavigateType = nfFromParent)
37591>>>                // If from parent, this is a constrained drill down.
37591>>>                Case Break
37592>>>
37592>>>            Case (NavigateData.eNavigateType = nfFromChild)
37595>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37595>>>                Case Break
37596>>>
37596>>>            Case Else // must be nfUndefined
37596>>>
37596>>>        Case End
37596>>>
37596>>>        Send SetActionButtons
37597>>>
37597>>>    End_Procedure
37598>>>
37598>>>End_Object 
