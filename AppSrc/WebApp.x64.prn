37589>>>    Procedure SetActionButtons
37592>>>        tWebNavigateData NavigateData
37592>>>        tWebNavigateData NavigateData
37592>>>        Boolean bHasRecord
37592>>>        Handle hoDD
37592>>>
37592>>>        Get Server to hoDD
37593>>>        Get GetNavigateData to NavigateData
37594>>>        Get HasRecord of hoDD to bHasRecord
37595>>>
37595>>>        // let's hide all buttons and then Show the ones we want
37595>>>        WebSet pbRender of oEditBtn to False
37596>>>        WebSet pbRender of oSaveBtn to False
37597>>>        WebSet pbRender of oCancelChangesBtn to False
37598>>>        WebSet pbRender of oDeleteBtn to False
37599>>>
37599>>>        If (NavigateData.bReadOnly) Begin
37601>>>            WebSet pbRender of oEditBtn to True
37602>>>        End
37602>>>>
37602>>>        Else Begin
37603>>>            WebSet pbRender of oSaveBtn to True
37604>>>            WebSet pbRender of oCancelChangesBtn to True
37605>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37606>>>        End
37606>>>>
37606>>>    End_Procedure
