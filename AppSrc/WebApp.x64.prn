38340>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38343>>>        Case Begin
38343>>>            Case (NavigateData.eNavigateType = nfFromMain)
38345>>>                // If from main, this is a propbably a main file Select to Zoom.
38345>>>                Case Break
38346>>>
38346>>>            Case (NavigateData.eNavigateType = nfFromParent)
38349>>>                // If from parent, this is a constrained drill down.
38349>>>                Case Break
38350>>>
38350>>>            Case (NavigateData.eNavigateType = nfFromChild)
38353>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38353>>>                Case Break
38354>>>
38354>>>            Case Else // must be nfUndefined
38354>>>
38354>>>        Case End
38354>>>
38354>>>        Send SetActionButtons
38355>>>
38355>>>    End_Procedure
38356>>>
