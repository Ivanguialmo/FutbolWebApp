38481>>>    Procedure SetActionButtons
38484>>>        tWebNavigateData NavigateData
38484>>>        tWebNavigateData NavigateData
38484>>>        Boolean bHasRecord
38484>>>        Handle hoDD
38484>>>
38484>>>        Get Server to hoDD
38485>>>        Get GetNavigateData to NavigateData
38486>>>        Get HasRecord of hoDD to bHasRecord
38487>>>
38487>>>        // let's hide all buttons and then Show the ones we want
38487>>>        WebSet pbRender of oEditBtn to False
38488>>>        WebSet pbRender of oSaveBtn to False
38489>>>        WebSet pbRender of oCancelChangesBtn to False
38490>>>        WebSet pbRender of oDeleteBtn to False
38491>>>
38491>>>        If (NavigateData.bReadOnly) Begin
38493>>>            WebSet pbRender of oEditBtn to True
38494>>>        End
38494>>>>
38494>>>        Else Begin
38495>>>            WebSet pbRender of oSaveBtn to True
38496>>>            WebSet pbRender of oCancelChangesBtn to True
38497>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38498>>>        End
38498>>>>
38498>>>    End_Procedure
