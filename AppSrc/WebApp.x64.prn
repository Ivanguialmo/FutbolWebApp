37617>>>
37617>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37620>>>        Case Begin
37620>>>            Case (NavigateData.eNavigateType = nfFromMain)
37622>>>                // If from main, this is a propbably a main file Select to Zoom.
37622>>>                Case Break
37623>>>
37623>>>            Case (NavigateData.eNavigateType = nfFromParent)
37626>>>                // If from parent, this is a constrained drill down.
37626>>>                Case Break
37627>>>
37627>>>            Case (NavigateData.eNavigateType = nfFromChild)
37630>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37630>>>                Case Break
37631>>>
37631>>>            Case Else // must be nfUndefined
37631>>>
37631>>>        Case End
37631>>>
37631>>>        Send SetActionButtons
37632>>>
37632>>>    End_Procedure
