37519>>>>>        Forward Send Construct_Object
37521>>>>>        Set Main_File to equipo.File_Number
37522>>>>>
37522>>>>>        Set Add_Server_File to liga.File_Number
37523>>>>>
37523>>>>>        Set Add_Client_File to entrenador.File_Number
37524>>>>>        Set Add_Client_File to jugador.File_Number
37525>>>>>
