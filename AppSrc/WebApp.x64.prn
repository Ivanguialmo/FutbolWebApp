39163>>>    Procedure SetActionButtons
39166>>>        tWebNavigateData NavigateData
39166>>>        tWebNavigateData NavigateData
39166>>>        Boolean bHasRecord
39166>>>        Handle hoDD
39166>>>
39166>>>        Get Server to hoDD
39167>>>        Get GetNavigateData to NavigateData
39168>>>        Get HasRecord of hoDD to bHasRecord
39169>>>
39169>>>        // let's hide all buttons and then Show the ones we want
39169>>>        WebSet pbRender of oEditBtn to False
39170>>>        WebSet pbRender of oSaveBtn to False
39171>>>        WebSet pbRender of oCancelChangesBtn to False
39172>>>        WebSet pbRender of oDeleteBtn to False
39173>>>        WebSet pbRender of oDespedirJugador to False
39174>>>        WebSet pbRender of oWebButtonPosiciones to False
39175>>>
39175>>>        If (NavigateData.bReadOnly) Begin
39177>>>            WebSet pbRender of oEditBtn to True
39178>>>        End
39178>>>>
39178>>>        Else Begin
39179>>>            WebSet pbRender of oSaveBtn to True
39180>>>            WebSet pbRender of oCancelChangesBtn to True
39181>>>            WebSet pbRender of oDespedirJugador to True
39182>>>            WebSet pbRender of oWebButtonPosiciones to True
39183>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39184>>>        End
39184>>>>
39184>>>    End_Procedure
39185>>>
