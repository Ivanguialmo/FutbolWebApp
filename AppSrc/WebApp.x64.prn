39051>>>    Procedure SetActionButtons
39054>>>        tWebNavigateData NavigateData
39054>>>        tWebNavigateData NavigateData
39054>>>        Boolean bHasRecord
39054>>>        Handle hoDD
39054>>>
39054>>>        Get Server to hoDD
39055>>>        Get GetNavigateData to NavigateData
39056>>>        Get HasRecord of hoDD to bHasRecord
39057>>>
39057>>>        // let's hide all buttons and then Show the ones we want
39057>>>        WebSet pbRender of oEditBtn to False
39058>>>        WebSet pbRender of oSaveBtn to False
39059>>>        WebSet pbRender of oCancelChangesBtn to False
39060>>>        WebSet pbRender of oDeleteBtn to False
39061>>>
39061>>>        If (NavigateData.bReadOnly) Begin
39063>>>            WebSet pbRender of oEditBtn to True
39064>>>        End
39064>>>>
39064>>>        Else Begin
39065>>>            WebSet pbRender of oSaveBtn to True
39066>>>            WebSet pbRender of oCancelChangesBtn to True
39067>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39068>>>        End
39068>>>>
39068>>>    End_Procedure
