38425>>>            Case (NavigateData.eNavigateType = nfFromParent)
38427>>>                // If from parent, this is a constrained drill down
38427>>>                // If Row select does main-zoom we don't need this
38427>>>                WebSet pbRender of oDetailButton to False
38428>>>                Case Break
38429>>>
38429>>>            Case (NavigateData.eNavigateType = nfFromChild)
38432>>>                // If from child, this is a probably a parent lookup from a Zoom
