39025>>>        tWebNavigateData NavigateData
39025>>>        tWebNavigateData NavigateData
39025>>>        Boolean bHasRecord
39025>>>        Handle hoDD
39025>>>
39025>>>        Get Server to hoDD
39026>>>        Get GetNavigateData to NavigateData
39027>>>        Get HasRecord of hoDD to bHasRecord
39028>>>
39028>>>        // let's hide all buttons and then Show the ones we want
39028>>>        WebSet pbRender of oEditBtn to False
39029>>>        WebSet pbRender of oSaveBtn to False
39030>>>        WebSet pbRender of oCancelChangesBtn to False
39031>>>        WebSet pbRender of oDeleteBtn to False
39032>>>
39032>>>        If (NavigateData.bReadOnly) Begin
39034>>>            WebSet pbRender of oEditBtn to True
39035>>>        End
39035>>>>
39035>>>        Else Begin
39036>>>            WebSet pbRender of oSaveBtn to True
39037>>>            WebSet pbRender of oCancelChangesBtn to True
39038>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39039>>>        End
39039>>>>
39039>>>    End_Procedure
