38519>>>    Procedure SetActionButtons
38522>>>        tWebNavigateData NavigateData
38522>>>        tWebNavigateData NavigateData
38522>>>        Boolean bHasRecord
38522>>>        Handle hoDD
38522>>>
38522>>>        Get Server to hoDD
38523>>>        Get GetNavigateData to NavigateData
38524>>>        Get HasRecord of hoDD to bHasRecord
38525>>>
38525>>>        // let's hide all buttons and then Show the ones we want
38525>>>        WebSet pbRender of oEditBtn to False
38526>>>        WebSet pbRender of oSaveBtn to False
38527>>>        WebSet pbRender of oCancelChangesBtn to False
38528>>>        WebSet pbRender of oDeleteBtn to False
38529>>>
38529>>>        If (NavigateData.bReadOnly) Begin
38531>>>            WebSet pbRender of oEditBtn to True
38532>>>        End
38532>>>>
38532>>>        Else Begin
38533>>>            WebSet pbRender of oSaveBtn to True
38534>>>            WebSet pbRender of oCancelChangesBtn to True
38535>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38536>>>        End
38536>>>>
38536>>>    End_Procedure
