39195>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39198>>>        Case Begin
39198>>>            Case (NavigateData.eNavigateType = nfFromMain)
39200>>>                // If from main, this is a propbably a main file Select to Zoom.
39200>>>                Case Break
39201>>>
39201>>>            Case (NavigateData.eNavigateType = nfFromParent)
39204>>>                // If from parent, this is a constrained drill down.
39204>>>                Case Break
39205>>>
39205>>>            Case (NavigateData.eNavigateType = nfFromChild)
39208>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39208>>>                Case Break
39209>>>
39209>>>            Case Else // must be nfUndefined
39209>>>
39209>>>        Case End
39209>>>        
39209>>>        If (HasRecord(Server(Self)))Begin
39211>>>            Send SetHeaderCaption (jugador.Nombre*jugador.Apellido)
39212>>>            Send SetBreadcrumbCaption (jugador.Nombre*jugador.Apellido)
39213>>>        End
39213>>>>
39213>>>        Else Begin
39214>>>            Send SetHeaderCaption "Nuevo Jugador"
39215>>>            Send SetBreadcrumbCaption "Nuevo"
39216>>>        End
39216>>>>
39216>>>
39216>>>        Send SetActionButtons
39217>>>
39217>>>    End_Procedure
39218>>>
39218>>>End_Object 
