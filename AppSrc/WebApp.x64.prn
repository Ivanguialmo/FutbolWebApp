37639>>>    Procedure SetActionButtons
37642>>>        tWebNavigateData NavigateData
37642>>>        tWebNavigateData NavigateData
37642>>>        Boolean bHasRecord
37642>>>        Handle hoDD
37642>>>
37642>>>        Get Server to hoDD
37643>>>        Get GetNavigateData to NavigateData
37644>>>        Get HasRecord of hoDD to bHasRecord
37645>>>
37645>>>        // let's hide all buttons and then Show the ones we want
37645>>>        WebSet pbRender of oEditBtn to False
37646>>>        WebSet pbRender of oSaveBtn to False
37647>>>        WebSet pbRender of oCancelChangesBtn to False
37648>>>        WebSet pbRender of oDeleteBtn to False
37649>>>
37649>>>        If (NavigateData.bReadOnly) Begin
37651>>>            WebSet pbRender of oEditBtn to True
37652>>>        End
37652>>>>
37652>>>        Else Begin
37653>>>            WebSet pbRender of oSaveBtn to True
37654>>>            WebSet pbRender of oCancelChangesBtn to True
37655>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37656>>>        End
37656>>>>
