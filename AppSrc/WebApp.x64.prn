39005>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39008>>>        Case Begin
39008>>>            Case (NavigateData.eNavigateType = nfFromMain)
39010>>>                // If from main, this is a propbably a main file Select to Zoom.
39010>>>                Case Break
39011>>>
39011>>>            Case (NavigateData.eNavigateType = nfFromParent)
39014>>>                // If from parent, this is a constrained drill down.
39014>>>                Case Break
39015>>>
39015>>>            Case (NavigateData.eNavigateType = nfFromChild)
39018>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39018>>>                Case Break
39019>>>
39019>>>            Case Else // must be nfUndefined
39019>>>
39019>>>        Case End
39019>>>        
39019>>>        If (HasRecord(Server(Self)))Begin
39021>>>            Send SetHeaderCaption (jugador.Nombre)
39022>>>            Send SetBreadcrumbCaption (jugador.Nombre*jugador.Apellido)
39023>>>        End
39023>>>>
39023>>>        Else Begin
39024>>>            Send SetHeaderCaption "Nuevo Jugador"
39025>>>            Send SetBreadcrumbCaption "Nuevo"
39026>>>        End
39026>>>>
39026>>>
39026>>>        Send SetActionButtons
39027>>>
39027>>>    End_Procedure
39028>>>
39028>>>End_Object 
