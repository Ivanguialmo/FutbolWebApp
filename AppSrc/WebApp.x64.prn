39093>>>
39093>>>        Case End
39093>>>        
39093>>>        If (HasRecord(Server(Self)))Begin
39095>>>            Send SetHeaderCaption (jugador.Nombre)
39096>>>            Send SetBreadcrumbCaption (jugador.Nombre*jugador.Apellido)
39097>>>        End
39097>>>>
39097>>>        Else Begin
39098>>>            Send SetHeaderCaption "Nuevo Jugador"
39099>>>            Send SetBreadcrumbCaption "Nuevo"
39100>>>        End
39100>>>>
39100>>>
39100>>>        Send SetActionButtons
39101>>>
