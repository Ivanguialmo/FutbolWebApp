38522>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38522>>>                Case Break
38523>>>
38523>>>            Case Else // must be nfUndefined
38523>>>
38523>>>        Case End
38523>>>
38523>>>        Send SetActionButtons
