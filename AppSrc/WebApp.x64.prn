38828>>>
38828>>>        Get Server to hoDD
38829>>>        Get GetNavigateData to NavigateData
38830>>>        Get HasRecord of hoDD to bHasRecord
38831>>>
38831>>>        // let's hide all buttons and then Show the ones we want
38831>>>        WebSet pbRender of oEditBtn to False
38832>>>        WebSet pbRender of oSaveBtn to False
38833>>>        WebSet pbRender of oCancelChangesBtn to False
38834>>>        WebSet pbRender of oDeleteBtn to False
38835>>>
38835>>>        If (NavigateData.bReadOnly) Begin
