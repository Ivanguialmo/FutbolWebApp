37554>>>    Procedure SetActionButtons
37557>>>        tWebNavigateData NavigateData
37557>>>        tWebNavigateData NavigateData
37557>>>        Boolean bHasRecord
37557>>>        Handle hoDD
37557>>>
37557>>>        Get Server to hoDD
37558>>>        Get GetNavigateData to NavigateData
37559>>>        Get HasRecord of hoDD to bHasRecord
37560>>>
37560>>>        // let's hide all buttons and then Show the ones we want
37560>>>        WebSet pbRender of oEditBtn to False
37561>>>        WebSet pbRender of oSaveBtn to False
37562>>>        WebSet pbRender of oCancelChangesBtn to False
37563>>>        WebSet pbRender of oDeleteBtn to False
37564>>>
37564>>>        If (NavigateData.bReadOnly) Begin
37566>>>            WebSet pbRender of oEditBtn to True
37567>>>        End
37567>>>>
37567>>>        Else Begin
37568>>>            WebSet pbRender of oSaveBtn to True
37569>>>            WebSet pbRender of oCancelChangesBtn to True
37570>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37571>>>        End
37571>>>>
37571>>>    End_Procedure
