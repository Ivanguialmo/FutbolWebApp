37844>>>        WebSet pbRender of oEditBtn to False
37845>>>        WebSet pbRender of oSaveBtn to False
37846>>>        WebSet pbRender of oCancelChangesBtn to False
37847>>>        WebSet pbRender of oDeleteBtn to False
37848>>>
37848>>>        If (NavigateData.bReadOnly) Begin
