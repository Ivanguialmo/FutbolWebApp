38437>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38440>>>        WebSet pbRender of oNewButton to True
38441>>>        WebSet pbRender of oDetailButton to True
38442>>>
38442>>>        Case Begin
38442>>>            Case (NavigateData.eNavigateType = nfFromParent)
38444>>>                // If from parent, this is a constrained drill down
38444>>>                // If Row select does main-zoom we don't need this
38444>>>                WebSet pbRender of oDetailButton to False
38445>>>                Case Break
38446>>>
38446>>>            Case (NavigateData.eNavigateType = nfFromChild)
38449>>>                // If from child, this is a probably a parent lookup from a Zoom
38449>>>                Case Break
38450>>>
38450>>>            Case (NavigateData.eNavigateType = nfFromMain)
38453>>>                // If from main, this is a probably a main-file lookup from a Zoom
38453>>>                WebSet pbRender of oDetailButton to False
38454>>>                Case Break
38455>>>
38455>>>            Case Else // must be nfUndefined
38455>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38455>>>                // If Row select does main-zoom we don't need this
38455>>>                Send ShowInfoBox "Esto es una navegación indefinida"
38456>>>                WebSet pbRender of oDetailButton to False
38457>>>
38457>>>        Case End
38457>>>
38457>>>    End_Procedure
38458>>>
38458>>>
38458>>>End_Object 
