38935>>>                // If from child, this is a probably a parent lookup from a Zoom
38935>>>                Case Break
38936>>>
38936>>>            Case (NavigateData.eNavigateType = nfFromMain)
38939>>>                // If from main, this is a probably a main-file lookup from a Zoom
38939>>>                WebSet pbRender of oDetailButton to True
38940>>>                Case Break
38941>>>
38941>>>            Case Else // must be nfUndefined
38941>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38941>>>                // If Row select does main-zoom we don't need this
38941>>>                WebSet pbRender of oDetailButton to True
38942>>>
38942>>>        Case End
